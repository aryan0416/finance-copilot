# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-db-password>

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=<random-secret-min-32-chars>

# AI provider: google-genai (Gemini, default) or ollama
AI_PROVIDER=google-genai
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
